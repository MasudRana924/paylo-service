              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiverPhone\": \"01712345678\",\n  \"pin\": \"1234\",\n  \"amount\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transaction/send-money",
              "host": ["{{baseUrl}}"],
              "path": ["transaction", "send-money"]
            }
          }
        },
        {
          "name": "Payment Link (to Merchant)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
