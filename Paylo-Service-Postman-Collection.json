    },
    {
      "name": "Admin (Super Admin)",
      "item": [
        {
          "name": "Create Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01712345678\",\n  \"pin\": \"1234\",\n  \"name\": \"Admin Name\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/create",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "create"]
            }
          }
        },
        {
          "name": "Disable Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01712345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/disable",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "disable"]
            }
          }
        },
        {
          "name": "List Admins",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/list",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "list"]
            }
          }
        },
        {
          "name": "Toggle Admin Wallet Permission",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/permission/wallet-status",
              "host": ["{{baseUrl}}"],
