    {
      "name": "Notifications (Admin/Super Admin)",
      "item": [
        {
          "name": "Create Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "Notification Title",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Notification description",
                  "type": "text"
                },
                {
                  "key": "notificationImage",
                  "type": "file",
                  "src": "/path/to/your/notification-image.jpg"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/admin/notification/create",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "notification", "create"]
            }
